From 8d34dfc1ef1c9411bd17acd1578e4b2fe68930cb Mon Sep 17 00:00:00 2001
From: Mr_Hall <174105745+MrHallM@users.noreply.github.com>
Date: Fri, 23 Oct 2026 23:04:24 -0400
Subject: [PATCH 1/2] setup_openiris: accept COM ports on Windows (sys.platform
 is 'win32', not 'windows')

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/setup_openiris.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/setup_openiris.py b/tools/setup_openiris.py
index 9a00354..f2c9a4c 100644
--- a/tools/setup_openiris.py
+++ b/tools/setup_openiris.py
@@ -604,7 +604,7 @@ def handle_menu(menu_context: dict | None = None) -> str:
 
 
 def valid_port(port: str):
-    if sys.platform == "windows":
+    if sys.platform.startswith("win"):
         if not port.startswith("COM"):
             raise argparse.ArgumentTypeError("Invalid port name. We only support COM ports")
     else:
