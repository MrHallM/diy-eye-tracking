From 883f2f73e589432039e1f28caf7df0ace4a94e72 Mon Sep 17 00:00:00 2001
From: Mr_Hall <174105745+MrHallM@users.noreply.github.com>
Date: Fri, 23 Oct 2026 23:21:56 -0400
Subject: [PATCH 2/2] setup_openiris: show the real error when a command times
 out instead of crashing

send_command returns {'error': ...} with no 'results' key on timeout, so get_response_error raised KeyError.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/setup_openiris.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tools/setup_openiris.py b/tools/setup_openiris.py
index f2c9a4c..9e673f3 100644
--- a/tools/setup_openiris.py
+++ b/tools/setup_openiris.py
@@ -155,6 +155,9 @@ def has_command_failed(result) -> bool:
 
 
 def get_response_error(result) -> str:
+    # send_command returns {"error": ...} on timeout/IO failure, with no "results"
+    if "error" in result:
+        return result["error"]
     return result["results"][0]["result"]["data"]
 
 
