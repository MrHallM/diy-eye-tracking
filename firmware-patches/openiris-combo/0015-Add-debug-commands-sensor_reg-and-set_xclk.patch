         return CommandResult::getErrorResult("Invalid zoom window");
 
     return CommandResult::getSuccessResult(size ? "Zoom set" : "Zoom off");
+}
+
+CommandResult sensorRegCommand(std::shared_ptr<DependencyRegistry> registry, const nlohmann::json& json)
+{
+    if (!json.contains("reg"))
+        return CommandResult::getErrorResult("Missing reg");
+
+    const int reg = json.at("reg").get<int>();  // bit 8 selects the OV2640 sensor bank, else DSP bank
+    const int mask = json.value("mask", 0xFF);
+    sensor_t* sensor = esp_camera_sensor_get();
+    if (!sensor)
+        return CommandResult::getErrorResult("No sensor");
+
+    if (json.contains("value") && sensor->set_reg(sensor, reg, mask, json.at("value").get<int>()) < 0)
+        return CommandResult::getErrorResult("Register write failed");
+
+    return CommandResult::getSuccessResult(std::to_string(sensor->get_reg(sensor, reg, mask)));
+}
+
+CommandResult setXclkCommand(std::shared_ptr<DependencyRegistry> registry, const nlohmann::json& json)
+{
+    const int mhz = json.value("mhz", 0);
+    sensor_t* sensor = esp_camera_sensor_get();
+    if (!sensor || mhz < 6 || mhz > 40)
+        return CommandResult::getErrorResult("mhz must be 6-40");
+    if (sensor->set_xclk(sensor, LEDC_TIMER_0, mhz) != ESP_OK)
+        return CommandResult::getErrorResult("XCLK change failed");
+    return CommandResult::getSuccessResult("XCLK set");
 }
