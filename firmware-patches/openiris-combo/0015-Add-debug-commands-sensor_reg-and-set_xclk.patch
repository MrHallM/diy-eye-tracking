@@ -29,6 +29,8 @@ std::unordered_map<std::string, CommandType> commandTypeMap = {
     {"get_battery_status", CommandType::GET_BATTERY_STATUS},
     {"get_who_am_i", CommandType::GET_WHO_AM_I},
     {"set_zoom", CommandType::SET_ZOOM},
+    {"sensor_reg", CommandType::SENSOR_REG},
