 .../commands/camera_commands.cpp              | 28 +++++++++++++++++++
 .../commands/camera_commands.hpp              |  4 +++
 components/RestAPI/RestAPI/RestAPI.cpp        |  2 ++
 5 files changed, 42 insertions(+)

