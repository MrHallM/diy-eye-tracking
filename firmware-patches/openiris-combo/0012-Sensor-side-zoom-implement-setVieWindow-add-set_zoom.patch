+// Sensor-side zoom: read a window of the sensor at SVGA detail (2x the CIF mode the 240x240
+// stream normally uses) and scale it to the configured output size. Window is in SVGA pixels
+// (800x600 covers the whole sensor); width 0 goes back to the normal full view.
 int CameraManager::setVieWindow(int offsetX, int offsetY, int outputX, int outputY)
 {
-    // todo safariMonkey made a PoC, implement it here
-    return 0;
+    if (outputX == 0)
+    {
+        const int ret = this->setCameraResolution(static_cast<framesize_t>(projectConfig->getCameraConfig().framesize));
+        this->applyGainAndExposure();  // the mode switch rewrites the sensor's register tables
+        return ret;
+    }
+
+    constexpr int SVGA_W = 800;
+    constexpr int SVGA_H = 600;
+    constexpr int OV2640_MODE_SVGA = 1;  // ov2640_sensor_mode_t, private to the driver
+    if (camera_sensor->id.PID != OV2640_PID || offsetX < 0 || offsetY < 0 || outputX < 8 || outputY < 8 || offsetX + outputX > SVGA_W ||
+        offsetY + outputY > SVGA_H)
+    {
+        return -1;
+    }
+
+    const auto& res = resolution[camera_sensor->status.framesize];
+    const int ret = camera_sensor->set_res_raw(camera_sensor, OV2640_MODE_SVGA, 0, 0, 0, offsetX, offsetY, outputX, outputY, res.width, res.height, false, false);
+    this->applyGainAndExposure();
+    return ret;
+}
+
+void CameraManager::applyGainAndExposure()
+{
+    const CameraConfig_t& cameraConfig = projectConfig->getCameraConfig();
+    camera_sensor->set_agc_gain(camera_sensor, std::min<int>(cameraConfig.brightness, 30));    // 0 to 30
+    camera_sensor->set_aec_value(camera_sensor, std::min<int>(cameraConfig.exposure, 1200));  // 0 to 1200
 }
 
 esp_err_t CameraManager::getLastCameraError() const
