+
+CommandResult setZoomCommand(std::shared_ptr<DependencyRegistry> registry, const nlohmann::json& json)
+{
+    const int x = json.value("x", 0);
+    const int y = json.value("y", 0);
+    const int size = json.value("size", 0);
+
+    std::shared_ptr<CameraManager> cameraManager = registry->resolve<CameraManager>(DependencyType::camera_manager);
+    if (cameraManager->setVieWindow(x, y, size, size) != 0)
+        return CommandResult::getErrorResult("Invalid zoom window");
+
+    return CommandResult::getSuccessResult(size ? "Zoom set" : "Zoom off");
 }
