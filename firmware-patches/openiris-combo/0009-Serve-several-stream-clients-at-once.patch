From bd24a95dbf3d4c4df2c152b7447ac593b5b48c5f Mon Sep 17 00:00:00 2001
From: Mr_Hall <174105745+MrHallM@users.noreply.github.com>
Date: Thu, 15 Oct 2026 19:01:53 -0400
Subject: [PATCH 09/19] Serve several stream clients at once

The stream handler looped forever inside the HTTP server's only task, so a
second viewer connected and got zero bytes. Detach each stream request with
httpd_req_async_handler_begin(), serve it from its own task, and fan the
latest frame out from a single capture task. Measured on a XIAO OV2640 at
240x240: 1 client 66.7 fps; 2 clients 66.5 + 66.3 fps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../StreamServer/StreamServer.cpp             | 203 +++++++++++++++++-
 .../StreamServer/StreamServer.hpp             |   2 +
 2 files changed, 204 insertions(+), 1 deletion(-)

diff --git a/components/StreamServer/StreamServer/StreamServer.cpp b/components/StreamServer/StreamServer/StreamServer.cpp
index 1b04082..cddde2a 100644
--- a/components/StreamServer/StreamServer/StreamServer.cpp
+++ b/components/StreamServer/StreamServer/StreamServer.cpp
@@ -1,6 +1,12 @@
 #include "StreamServer.hpp"
 #include <sys/time.h>
 
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <vector>
+
 constexpr static const char* STREAM_CONTENT_TYPE = "multipart/x-mixed-replace;boundary=" PART_BOUNDARY;
 constexpr static const char* STREAM_BOUNDARY = "\r\n--" PART_BOUNDARY "\r\n";
 constexpr static const char* STREAM_PART = "Content-Type: image/jpeg\r\nContent-Length: %u\r\nX-Timestamp: %lli.%06li\r\n\r\n";
@@ -149,6 +155,201 @@ esp_err_t StreamHelpers::stream(httpd_req_t* req)
     return response;
 }
 
+// ---------------------------------------------------------------------------------------------
+// Multi-client streaming.
+//
+// The handler above loops forever inside the HTTP server's single task, so while one client
+// streams, the server cannot service anything else: a second viewer (e.g. a recorder next to
+// Baballonia) connects and gets zero bytes. Instead, each stream request is detached with
+// httpd_req_async_handler_begin() and served from its own task, and one capture task fans the
+// latest frame out to every client. With a single client this is the same capture cadence as
+// before plus one small memcpy per frame.
+// ---------------------------------------------------------------------------------------------
+namespace
+{
+struct SharedFrame
+{
+    std::vector<uint8_t> data;
+    struct timeval timestamp;
+};
+
+struct FrameHub
+{
+    std::mutex mutex;
+    std::condition_variable newFrame;
+    std::shared_ptr<const SharedFrame> latest;
+    uint32_t sequence = 0;
+    int clients = 0;
+    bool captureTaskStarted = false;
+    StreamUserCtx ctx{};
+};
+
+FrameHub hub;
+
+void CaptureTask(void*)
+{
+    int64_t windowStart = esp_timer_get_time();
+    int windowFrames = 0;
+
+    while (true)
+    {
+        {
+            std::unique_lock<std::mutex> lock(hub.mutex);
+            if (hub.clients == 0)
+            {
+                lock.unlock();
+                vTaskDelay(pdMS_TO_TICKS(20));
+                continue;
+            }
+        }
+
+        auto frame = std::make_shared<SharedFrame>();
+        const bool cameraFailed = hub.ctx.stateManager && hub.ctx.stateManager->GetCameraState() == CameraState_e::Camera_Error;
+        const uint8_t* diagBuf = nullptr;
+        size_t diagLen = 0;
+
+        if (cameraFailed && hub.ctx.cameraManager && hub.ctx.cameraManager->getDiagnosticFrame(&diagBuf, &diagLen))
+        {
+            gettimeofday(&frame->timestamp, nullptr);
+            frame->data.assign(diagBuf, diagBuf + diagLen);
+        }
+        else
+        {
+            camera_fb_t* fb = esp_camera_fb_get();
+            if (!fb)
+            {
+                ESP_LOGE(STREAM_SERVER_TAG, "Camera capture failed");
+                vTaskDelay(pdMS_TO_TICKS(10));
+                continue;
+            }
+            frame->timestamp = fb->timestamp;
+            frame->data.assign(fb->buf, fb->buf + fb->len);
+            esp_camera_fb_return(fb);
+        }
+
+        const size_t frameLen = frame->data.size();
+        {
+            std::lock_guard<std::mutex> lock(hub.mutex);
+            hub.latest = std::move(frame);
+            hub.sequence++;
+        }
+        hub.newFrame.notify_all();
+
+        if (cameraFailed)
+        {
+            // No real capture rate to pace against; throttle the repeated diagnostic frame.
+            vTaskDelay(pdMS_TO_TICKS(500));
+        }
+
+        if (++windowFrames == 100)
+        {
+            const int64_t now = esp_timer_get_time();
+            const long windowMs = (long)((now - windowStart) / 1000);
+            ESP_LOGI(STREAM_SERVER_TAG, "100 Frames Size: %uKB, Time: %lims (%lifps)", frameLen / 1024, windowMs, windowMs > 0 ? 100000 / windowMs : 0);
+            windowStart = now;
+            windowFrames = 0;
+        }
+    }
+}
+
+esp_err_t sendFrame(httpd_req_t* req, const SharedFrame& frame)
+{
+    char part_buf[256];
+    esp_err_t response = httpd_resp_send_chunk(req, STREAM_BOUNDARY, strlen(STREAM_BOUNDARY));
+    if (response == ESP_OK)
+    {
+        size_t hlen = snprintf(part_buf, sizeof(part_buf), STREAM_PART, frame.data.size(), frame.timestamp.tv_sec, frame.timestamp.tv_usec);
+        response = httpd_resp_send_chunk(req, part_buf, hlen);
+    }
+    if (response == ESP_OK)
+        response = httpd_resp_send_chunk(req, (const char*)frame.data.data(), frame.data.size());
+    return response;
+}
+
+void ClientTask(void* param)
+{
+    auto* req = static_cast<httpd_req_t*>(param);
+    QueueHandle_t eventQueue = hub.ctx.stateManager ? hub.ctx.stateManager->GetEventQueue() : nullptr;
+
+    uint32_t lastSent = 0;
+    while (true)
+    {
+        std::shared_ptr<const SharedFrame> frame;
+        {
+            std::unique_lock<std::mutex> lock(hub.mutex);
+            // timeout so a stalled camera can't park this task forever with no way to notice
+            hub.newFrame.wait_for(lock, std::chrono::seconds(2), [&] { return hub.sequence != lastSent; });
+            if (hub.sequence == lastSent)
+                continue;
+            lastSent = hub.sequence;
+            frame = hub.latest;
+        }
+        if (frame && sendFrame(req, *frame) != ESP_OK)
+            break;
+    }
+
+    bool lastClient;
+    {
+        std::lock_guard<std::mutex> lock(hub.mutex);
+        lastClient = --hub.clients == 0;
+    }
+    if (lastClient)
+        SendStreamEvent(eventQueue, StreamState_e::Stream_OFF);
+
+    httpd_req_async_handler_complete(req);
+    vTaskDelete(nullptr);
+}
+}  // namespace
+
+esp_err_t StreamHelpers::stream_async(httpd_req_t* req)
+{
+    auto* ctx = static_cast<StreamUserCtx*>(req->user_ctx);
+
+    httpd_req_t* detached = nullptr;
+    if (httpd_req_async_handler_begin(req, &detached) != ESP_OK)
+    {
+        ESP_LOGW(STREAM_SERVER_TAG, "Could not detach the stream request, serving it inline");
+        return StreamHelpers::stream(req);
+    }
+
+    // headers go on the detached copy, which is the request the client task responds through
+    if (httpd_resp_set_type(detached, STREAM_CONTENT_TYPE) != ESP_OK)
+    {
+        httpd_req_async_handler_complete(detached);
+        return ESP_FAIL;
+    }
+    httpd_resp_set_hdr(detached, "Access-Control-Allow-Origin", "*");
+    httpd_resp_set_hdr(detached, "X-Framerate", "60");
+
+    bool firstClient;
+    {
+        std::lock_guard<std::mutex> lock(hub.mutex);
+        if (ctx)
+            hub.ctx = *ctx;
+        firstClient = hub.clients++ == 0;
+        if (!hub.captureTaskStarted)
+        {
+            hub.captureTaskStarted = xTaskCreate(CaptureTask, "StreamCapture", 1024 * 4, nullptr, 5, nullptr) == pdPASS;
+        }
+    }
+    if (firstClient && hub.ctx.stateManager)
+        SendStreamEvent(hub.ctx.stateManager->GetEventQueue(), StreamState_e::Stream_ON);
+
+    if (!hub.captureTaskStarted || xTaskCreate(ClientTask, "StreamClient", 1024 * 4, detached, 5, nullptr) != pdPASS)
+    {
+        ESP_LOGE(STREAM_SERVER_TAG, "Could not start the stream tasks");
+        {
+            std::lock_guard<std::mutex> lock(hub.mutex);
+            hub.clients--;
+        }
+        httpd_req_async_handler_complete(detached);
+        return ESP_FAIL;
+    }
+
+    ESP_LOGI(STREAM_SERVER_TAG, "Stream client connected (%d active)", hub.clients);
+    return ESP_OK;
+}
+
 esp_err_t StreamHelpers::ws_logs_handle(httpd_req_t* req)
 {
     auto ret = webSocketLogger.register_socket_client(req);
@@ -170,7 +371,7 @@ esp_err_t StreamServer::startStreamServer()
     httpd_uri_t stream_page = {
         .uri = "/",
         .method = HTTP_GET,
-        .handler = &StreamHelpers::stream,
+        .handler = &StreamHelpers::stream_async,
         .user_ctx = &this->userCtx,
     };
 
diff --git a/components/StreamServer/StreamServer/StreamServer.hpp b/components/StreamServer/StreamServer/StreamServer.hpp
index 9d29c3d..15b4ae2 100644
--- a/components/StreamServer/StreamServer/StreamServer.hpp
+++ b/components/StreamServer/StreamServer/StreamServer.hpp
@@ -26,6 +26,8 @@ struct StreamUserCtx
 namespace StreamHelpers
 {
 esp_err_t stream(httpd_req_t* req);
+// Detaches the request and serves it from its own task so several clients can stream at once.
+esp_err_t stream_async(httpd_req_t* req);
 esp_err_t ws_logs_handle(httpd_req_t* req);
 }  // namespace StreamHelpers
 
