+CommandResult getTemperatureCommand(std::shared_ptr<DependencyRegistry> registry)
+{
+    // ESP32 die temperature (not the camera module's); installed once, on first use
+    static temperature_sensor_handle_t tsens = nullptr;
+    if (!tsens)
+    {
+        temperature_sensor_config_t config = TEMPERATURE_SENSOR_CONFIG_DEFAULT(20, 100);
+        if (temperature_sensor_install(&config, &tsens) != ESP_OK || temperature_sensor_enable(tsens) != ESP_OK)
+        {
+            tsens = nullptr;
+            return CommandResult::getErrorResult("Temperature sensor unavailable");
+        }
+    }
+
+    float celsius = 0;
+    if (temperature_sensor_get_celsius(tsens, &celsius) != ESP_OK)
+        return CommandResult::getErrorResult("Temperature read failed");
+
+    char buf[16];
+    snprintf(buf, sizeof(buf), "%.1f", celsius);
+    return CommandResult::getSuccessResult(buf);
+}
+
 CommandResult setXclkCommand(std::shared_ptr<DependencyRegistry> registry, const nlohmann::json& json)
 {
